# Public site URL used for sitemap, canonical URLs and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Destination inbox for website enquiries. Defaults to Aya's public email if unset.
CONTACT_EMAIL=aya.emam@gmail.com

# Optional: verified sender address when using Resend.
FROM_EMAIL=

# Optional: Resend API key. If empty, enquiries still go to CONTACT_EMAIL via FormSubmit.
RESEND_API_KEY=
